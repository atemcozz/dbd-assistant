generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  LOBBY
  RUNNING
  FINISHED
}

enum PlayerRole {
  SURVIVOR
  KILLER
}

enum PlayerStatus {
  ALIVE
  DEAD
  DISCONNECTED
}

enum QuestStatus {
  AVAILABLE
  COMPLETED
}

model Game {
  id            String     @id @default(cuid())
  code          String     @unique
  name          String
  status        GameStatus @default(LOBBY)
  ownerPlayerId String
  createdAt     DateTime   @default(now())
  startedAt     DateTime?
  durationSeconds Int       @default(3600)
  players       Player[]
  quests        GameQuest[]
}

model QuestDefinition {
  id                    String      @id
  name                  String
  description           String
  type                  String
  radius                Int?
  settings              String
  killerCharacterTypeId String?
  gameQuests            GameQuest[]
}

model GameQuest {
  id                String         @id @default(cuid())
  gameId            String
  game              Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questDefinitionId String
  questDefinition   QuestDefinition @relation(fields: [questDefinitionId], references: [id])
  number            Int
  status            QuestStatus    @default(AVAILABLE)
  completedBy       String?
  completedAt       DateTime?

  @@unique([gameId, number])
  @@unique([gameId, questDefinitionId])
  @@index([gameId])
}

model Player {
  id              String        @id @default(cuid())
  gameId          String
  game            Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name            String
  sessionToken    String        @unique
  role            PlayerRole    @default(SURVIVOR)
  characterTypeId String?
  characterType   CharacterType? @relation(fields: [characterTypeId], references: [id])
  health          Int           @default(1)
  maxHealth       Int           @default(1)
  status          PlayerStatus  @default(ALIVE)
  createdAt       DateTime      @default(now())

  @@index([gameId])
}

model CharacterType {
  id            String       @id
  role          PlayerRole
  name          String
  description   String
  maxHealth     Int
  players       Player[]
}
