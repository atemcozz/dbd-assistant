generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  LOBBY
  RUNNING
  FINISHED
}

enum PlayerRole {
  SURVIVOR
  KILLER
}

enum PlayerStatus {
  ALIVE
  DEAD
  DISCONNECTED
  ESCAPED
}

enum QuestStatus {
  AVAILABLE
  COMPLETED
}

model Game {
  id            String     @id @default(cuid())
  code          String     @unique
  name          String
  status        GameStatus @default(LOBBY)
  ownerPlayerId String?
  ownerPlayer   Player? @relation("GameOwner", fields: [ownerPlayerId], references: [id])
  createdAt     DateTime   @default(now())
  startedAt     DateTime?
  finishedAt DateTime?
  durationSeconds Int       @default(3600)
  // Total quest points needed to unlock the exits.
  // Sum of completed quest costs is compared against this value.
  requiredQuestPoints Int    @default(500)
  // Who won when the game finished: 'SURVIVORS' | 'KILLER' | 'DRAW' | null.
  // DRAW = time out with survivors still alive and not escaped (both lose).
  winner        String?
  players       Player[]
  quests        GameQuest[]
  exits         GameExit[]
  chatMessages  ChatMessage[]
}

model QuestDefinition {
  id                    String      @id
  name                  String
  description           String
  type                  String
  radius                Int?
  // Point value of this quest. Completed quest costs sum toward requiredQuestPoints.
  cost                  Int         @default(100)
  killerCharacterTypeId String?
  killerCharacterType   CharacterType? @relation(fields: [killerCharacterTypeId], references: [id])
  gameQuests            GameQuest[]
}

model GameQuest {
  id                String         @id @default(cuid())
  gameId            String
  game              Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questDefinitionId String
  questDefinition   QuestDefinition @relation(fields: [questDefinitionId], references: [id])
  number            Int
  status            QuestStatus    @default(AVAILABLE)
  completedById String?
  completedBy   Player? @relation("QuestCompletedBy", fields: [completedById], references: [id])
  completedAt       DateTime?

  @@unique([gameId, number])
  @@unique([gameId, questDefinitionId])
  @@index([gameId])
}

// Reusable exit definition — physical escape routes in the venue.
// Like quests, these live in config/exits.json and are synced to SQLite.
model ExitDefinition {
  id          String     @id
  name        String
  description String
  gameExits   GameExit[]
}

// An exit selected for a specific game (owner picks these in the lobby).
// No status field — an exit is just available once the game runs and
// quest points are met. Usage is tracked on the Player (ESCAPED status).
model GameExit {
  id               String         @id @default(cuid())
  gameId           String
  game             Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  exitDefinitionId String
  exitDefinition   ExitDefinition @relation(fields: [exitDefinitionId], references: [id])

  @@unique([gameId, exitDefinitionId])
  @@index([gameId])
}

model Player {
  id              String        @id @default(cuid())
  gameId          String
  game            Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name            String
  sessionToken    String        @unique
  role            PlayerRole    @default(SURVIVOR)
  characterTypeId String?
  characterType   CharacterType? @relation(fields: [characterTypeId], references: [id])
  health          Int?
  status          PlayerStatus  @default(ALIVE)
  // When this player escaped through an exit (null unless ESCAPED).
  escapedAt       DateTime?
  createdAt       DateTime      @default(now())
  chatMessages    ChatMessage[]
  abilities       PlayerAbility[]
  buffsGiven      ActiveBuff[] @relation("BuffSource")
  buffsReceived   ActiveBuff[] @relation("BuffTarget")
  ownedGames Game[] @relation("GameOwner")
  completedQuests GameQuest[] @relation("QuestCompletedBy")

  @@index([gameId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  gameId    String
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player @relation(fields: [playerId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
}

model CharacterType {
  id            String       @id
  role          PlayerRole
  name          String
  description   String
  maxHealth     Int?
  players       Player[]
  killerQuests  QuestDefinition[]
  characterAbilities   CharacterAbility[]
  characterStartBuffs  CharacterStartBuff[]
}

// Character kit entry — an ability the character starts with.
model CharacterAbility {
  id              String           @id @default(cuid())
  characterTypeId String
  characterType   CharacterType    @relation(fields: [characterTypeId], references: [id], onDelete: Cascade)
  abilityId       String
  ability         AbilityDefinition @relation(fields: [abilityId], references: [id])
  // Optional starting use count for this character (null = unlimited).
  count           Int?

  @@unique([characterTypeId, abilityId])
}

// Permanent (or timed) buff a character starts with — replaces the old
// PASSIVE effect hack. Applied to the player on character assignment.
model CharacterStartBuff {
  id              String           @id @default(cuid())
  characterTypeId String
  characterType   CharacterType    @relation(fields: [characterTypeId], references: [id], onDelete: Cascade)
  buffId          String
  buff            BuffDefinition   @relation(fields: [buffId], references: [id])
  // Seconds; null = inherit BuffDefinition.defaultDuration.
  duration        Int?

  @@unique([characterTypeId, buffId])
}

// Reusable buff definition — a state that can be applied to a player.
// Config source of truth: config/buffs.json.
model BuffDefinition {
  id          String @id
  name        String
  description String
  // What the buff does: HEAL | HURT | INFO.
  // HEAL/HURT resolve instantly; INFO creates a timed ActiveBuff row.
  action      String
  // Arbitrary JSON interpreted per action, e.g. {"quantity":1} for HEAL/HURT.
  params      String @default("{}")
  // Default duration in seconds for INFO buffs; null = permanent.
  defaultDuration Int?
  abilityBuffs        AbilityBuff[]
  characterStartBuffs CharacterStartBuff[]
  activeBuffs         ActiveBuff[]
}

// Reusable ability definition — an activatable action a player can use.
// Config source of truth: config/abilities.json.
model AbilityDefinition {
  id             String @id
  name           String
  description    String
  // Cooldown in seconds between uses.
  cooldown       Int
  // JSON array of allowed target types: SELF | SURVIVOR | KILLER | ALL_SURVIVORS.
  allowedTargets String
  buffs             AbilityBuff[]
  characterAbilities CharacterAbility[]
  playerAbilities    PlayerAbility[]
}

// Which buffs an ability inflicts when used.
model AbilityBuff {
  id        String            @id @default(cuid())
  abilityId String
  ability   AbilityDefinition @relation(fields: [abilityId], references: [id], onDelete: Cascade)
  buffId    String
  buff      BuffDefinition    @relation(fields: [buffId], references: [id])
  // Duration override in seconds; null = inherit BuffDefinition.defaultDuration.
  duration  Int?

  @@unique([abilityId, buffId])
}

// An ability owned by a specific player (copied from the character kit).
model PlayerAbility {
  id         String            @id @default(cuid())
  playerId   String
  player     Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  abilityId  String
  ability    AbilityDefinition @relation(fields: [abilityId], references: [id])
  // Remaining uses (null = unlimited). Copied from CharacterAbility.count
  // when the character is assigned; decremented on every use.
  chargesRemaining Int?
  lastUsedAt DateTime?

  @@unique([playerId, abilityId])
}

// A buff currently applied to a player (timed or permanent).
model ActiveBuff {
  id             String         @id @default(cuid())
  buffId         String
  buff           BuffDefinition @relation(fields: [buffId], references: [id])
  sourcePlayerId String?
  sourcePlayer   Player?        @relation("BuffSource", fields: [sourcePlayerId], references: [id])
  targetPlayerId String
  targetPlayer   Player         @relation("BuffTarget", fields: [targetPlayerId], references: [id])
  appliedAt      DateTime       @default(now())
  // null = permanent buff.
  expiresAt      DateTime?

  @@index([targetPlayerId, expiresAt])
}