generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  LOBBY
  RUNNING
  FINISHED
}

enum PlayerRole {
  SURVIVOR
  KILLER
}

enum PlayerStatus {
  ALIVE
  DEAD
  DISCONNECTED
}

enum QuestStatus {
  AVAILABLE
  COMPLETED
}

model Game {
  id            String     @id @default(cuid())
  code          String     @unique
  name          String
  status        GameStatus @default(LOBBY)
  ownerPlayerId String?
  ownerPlayer   Player? @relation("GameOwner", fields: [ownerPlayerId], references: [id])
  createdAt     DateTime   @default(now())
  startedAt     DateTime?
  finishedAt DateTime?
  durationSeconds Int       @default(3600)
  // Total quest points needed to unlock the exits.
  // Sum of completed quest costs is compared against this value.
  requiredQuestPoints Int    @default(500)
  players       Player[]
  quests        GameQuest[]
  chatMessages  ChatMessage[]
}

model QuestDefinition {
  id                    String      @id
  name                  String
  description           String
  type                  String
  radius                Int?
  // Point value of this quest. Completed quest costs sum toward requiredQuestPoints.
  cost                  Int         @default(100)
  killerCharacterTypeId String?
  killerCharacterType   CharacterType? @relation(fields: [killerCharacterTypeId], references: [id])
  gameQuests            GameQuest[]
}

model GameQuest {
  id                String         @id @default(cuid())
  gameId            String
  game              Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questDefinitionId String
  questDefinition   QuestDefinition @relation(fields: [questDefinitionId], references: [id])
  number            Int
  status            QuestStatus    @default(AVAILABLE)
  completedById String?
  completedBy   Player? @relation("QuestCompletedBy", fields: [completedById], references: [id])
  completedAt       DateTime?

  @@unique([gameId, number])
  @@unique([gameId, questDefinitionId])
  @@index([gameId])
}

model Player {
  id              String        @id @default(cuid())
  gameId          String
  game            Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name            String
  sessionToken    String        @unique
  role            PlayerRole    @default(SURVIVOR)
  characterTypeId String?
  characterType   CharacterType? @relation(fields: [characterTypeId], references: [id])
  health          Int?
  status          PlayerStatus  @default(ALIVE)
  createdAt       DateTime      @default(now())
  chatMessages    ChatMessage[]
  effects        PlayerEffect[]
  effectsGiven   ActiveEffect[] @relation("EffectSource")
  effectsReceived ActiveEffect[] @relation("EffectTarget")
  ownedGames Game[] @relation("GameOwner")
  completedQuests GameQuest[] @relation("QuestCompletedBy")

  @@index([gameId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  gameId    String
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player @relation(fields: [playerId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
}

model CharacterType {
  id            String       @id
  role          PlayerRole
  name          String
  description   String
  maxHealth     Int?
  players       Player[]
  killerQuests  QuestDefinition[]
  characterEffects CharacterEffect[]
}

model CharacterEffect {
  id            String        @id @default(cuid())
  characterTypeId String
  characterType CharacterType @relation(fields: [characterTypeId], references: [id], onDelete: Cascade)
  effectId      String
  effect        EffectDefinition @relation(fields: [effectId], references: [id])
  charges       Int?

  @@unique([characterTypeId, effectId])
}

model EffectDefinition {
  id                String @id
  name              String
  description       String
  // What the TARGET sees when this effect is applied to them.
  // Falls back to `description` when null.
  targetDescription String?
  action            String
  quantity          Int
  duration          Int?
  cooldown          Int
  allowedTargets    String
  playerEffects     PlayerEffect[]
  activeEffects     ActiveEffect[]
  characterEffects  CharacterEffect[]
}

model ActiveEffect {
  id             String   @id @default(cuid())
  effectId       String
  effect        EffectDefinition @relation(fields: [effectId], references: [id])
  sourcePlayerId String?
  sourcePlayer   Player?  @relation("EffectSource", fields: [sourcePlayerId], references: [id])
  targetPlayerId String
  targetPlayer   Player   @relation("EffectTarget", fields: [targetPlayerId], references: [id])
  appliedAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([targetPlayerId, expiresAt])
}

model PlayerEffect {
  id          String @id @default(cuid())
  playerId    String
  player      Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  effectId    String
  effect      EffectDefinition @relation(fields: [effectId], references: [id])
  charges     Int?
  lastUsedAt  DateTime?

  @@unique([playerId, effectId])
}