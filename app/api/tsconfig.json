{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "moduleResolution": "nodenext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    // Matches how ts-jest transpiles test files (per-file). Also makes
    // tsc flag re-exports that transpilers cannot resolve (use
    // `import type` / `export type` for types).
    "isolatedModules": true,
    // Global types for Node APIs (src/scripts) and jest globals (test/).
    // Every other library ships its own types via real imports, so this
    // list is complete — do NOT narrow it to ["jest"] alone, that drops
    // `process`/`Buffer`/`__dirname` and breaks compilation everywhere.
    "types": ["node", "jest"]
  },
  // The program the editor, tsc --noEmit, ts-jest and ts-node all share.
  // nest build narrows this to src/ via tsconfig.build.json.
  "include": ["src", "test", "scripts"]
}
