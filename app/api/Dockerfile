# syntax=docker/dockerfile:1
# NestJS API image. Build from the repository root:
#   docker build -f app/api/Dockerfile .

# ---- Dependencies ----------------------------------------------------------
# devDependencies are kept in the final image on purpose: `prisma db push`
# (Prisma CLI) and `config:sync` (ts-node) run on container start.
FROM node:24-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY app/api/package.json app/api/package.json
COPY app/web/package.json app/web/package.json
RUN npm ci --workspace=@dbd-assistant/api \
  && npm cache clean --force

# ---- Build ----------------------------------------------------------------
FROM deps AS build
WORKDIR /app
COPY config ./config
COPY app/api ./app/api
WORKDIR /app/app/api
RUN npm run prisma:generate && npm run build

# ---- Runtime ---------------------------------------------------------------
FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /app/app/api

# Copy node_modules from the build stage (not deps) so the Prisma query
# engine generated by `prisma generate` is included.
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/package.json /app/package-lock.json /app/
COPY --from=build /app/app/api/package.json ./package.json
COPY --from=build /app/app/api/dist ./dist
COPY --from=build /app/app/api/scripts ./scripts
COPY --from=build /app/app/api/tsconfig.json ./tsconfig.json
COPY --from=build /app/app/api/prisma/schema.prisma ./prisma/schema.prisma
# Baked-in default config — shadowed by the ./config bind mount in compose.
COPY --from=build /app/config /app/config

EXPOSE 3000

# Bring the schema and config into the DB, then start. `db push` on SQLite
# is cheap and keeps the manual recovery flow working:
# edit config -> restart container.
CMD ["sh", "-c", "npm run db:push && npm run config:sync && node dist/main.js"]
