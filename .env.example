# Docker compose environment — copy to .env and adjust:
#   cp .env.example .env
# docker compose reads .env automatically for ${...} substitution below.

# ---- host ports -----------------------------------------------------------
# Web UI:  http://<server>:WEB_PORT
# API:     http://<server>:API_PORT
WEB_PORT=3333
API_PORT=4444

# ---- persistence ----------------------------------------------------------
# SQLite database location on the HOST, mounted into the api container
# at /data. game.db appears here on first start.
DATA_DIR=./data

# SQLite path INSIDE the api container. Keep it absolute — relative paths
# are resolved against the Prisma schema directory, not the workdir.
DATABASE_URL=file:/data/game.db

# ---- optional -------------------------------------------------------------
# Absolute API URL baked into the frontend build. Leave empty: the app then
# uses http://<page hostname>:3000 at runtime, which works for localhost and
# LAN play without rebuilding. Set it only if API_PORT is changed or the UI
# is served behind a reverse proxy.
API_BASE_URL=https://delta.atemcozz.fun/dbdassistant/api
VITE_API_URL=https://delta.atemcozz.fun/dbdassistant/api
VITE_BASE_URL=/dbdassistant/