{
  "name": "dbd-assistant",
  "private": true,
  "workspaces": [
    "app/web",
    "app/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "config:sync": "npm run config:sync --workspace=@dbd-assistant/api"
  }
}
